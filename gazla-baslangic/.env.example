# Bu dosyayı .env olarak kopyala; .env git'e girmez. Expo CLI .env'i app.config.ts'ten önce yükler.
# EXPO_PUBLIC_* değerleri uygulamaya gömülür (gizli değer yazma); diğerleri yalnızca derlemede okunur.
# EAS Build'de .env gitmez: aynı adlarla EAS ortam değişkeni tanımla (eas env:create).

# --- Supabase (Project Settings → API) -------------------------------------------------------
# İkisi de doluysa uygulama Supabase'e bağlanır, boşsa örnek veriyle (mock) çalışır.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Web sitesi, davet linki, destek ---------------------------------------------------------
# Web sitesi kökü (yasal sayfalar bunun altında). Boşsa https://gazla.app varsayılır.
EXPO_PUBLIC_WEB_BASE_URL=
# Davet linki kökü; boşsa <WEB_BASE_URL>/d (link: <kök>/<kod>). Alan adı evrensel link olarak da
# kullanılır: iOS associatedDomains (applinks:<alan>) ve Android App Links (https://<alan>/d/*).
# Alanın kökünde /.well-known/apple-app-site-association ve /.well-known/assetlinks.json olmalı.
EXPO_PUBLIC_INVITE_BASE_URL=
# Destek e-postası (Ayarlar > Bize yaz)
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- Uygulama kimliği ve EAS ---------------------------------------------------------------------
# iOS bundle id ve Android paket adı. Boşsa app.gazla.
APP_ID=
# EAS proje kimliği (`npx eas-cli init` çıktısı; expo.dev → proje → "ID"). Expo push token'ı için
# gerekli (extra.eas.projectId); boşsa alan eklenmez ve uygulama push kaydını uyarıyla atlar.
# EXPO_PUBLIC_EAS_PROJECT_ID adıyla da okunur.
EAS_PROJECT_ID=

# --- Google ile giriş (Google Cloud Console → Kimlik bilgileri) -------------------------------
# "Web uygulaması" türündeki OAuth istemci kimliği: idToken'ın hedef kitlesi. Supabase Auth →
# Providers → Google'daki "Client ID" alanına da bu (ve iOS istemci kimliği, virgülle) yazılır.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# "iOS" türündeki OAuth istemci kimliği (123-abc.apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS URL şeması: iOS istemci kimliğinin ters hali (com.googleusercontent.apps.123-abc). Boşsa iOS
# istemci kimliğinden türetilir; ikisi de boşsa Google Sign-In plugin'i eklenmez ve giriş tarayıcıda açılır.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# --- AdMob (apps.admob.com) ------------------------------------------------------------------------
# Uygulama kimlikleri (ca-app-pub-…~…), yalnızca derlemede. Boşsa Google'ın resmi TEST uygulama
# kimlikleri: Android ca-app-pub-3940256099942544~3347511713, iOS ca-app-pub-3940256099942544~1458002511.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# Reklam birimleri (ca-app-pub-…/…). Boşsa ya da geliştirme sürümündeyse Google'ın test birimleri.
# Banner: Keşfet. Rewarded: seri kurtarma (StreakLost); ödül SSV ile sunucuda doğrulanır — AdMob'da
# birimin "Sunucu tarafı doğrulama" adresine Edge Function `admob-ssv` URL'sini yaz (supabase/README.md).
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
# Yalnızca geliştirme sürümünde: UMP test coğrafyası (EEA | OTHER | REGULATED_US_STATE) ve test cihazları
EXPO_PUBLIC_ADS_DEBUG_GEOGRAPHY=
EXPO_PUBLIC_ADS_TEST_DEVICE_IDS=

# --- Sentry (sentry.io → proje → Client Keys) -----------------------------------------------------
# Hata takibi: DSN tanımlıysa yayın sürümünde açılır (geliştirmede kapalı). Gizli değildir, uygulamaya gömülür.
EXPO_PUBLIC_SENTRY_DSN=
# Kaynak haritası yüklemesi (yalnızca derlemede): kuruluş ve proje adı. Token GİZLİDİR: .env'e değil, EAS ortam
# değişkeni olarak SENTRY_AUTH_TOKEN adıyla tanımla (eas env:create).
SENTRY_ORG=
SENTRY_PROJECT=

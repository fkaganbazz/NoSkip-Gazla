# Supabase projesi (Project Settings → API). İkisi de doluysa uygulama Supabase'e bağlanır,
# boşsa örnek veriyle (mock) çalışır. Bu dosyayı .env olarak kopyala; .env git'e girmez.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web sitesi ve davet linki (yayından önce gerçek alan adıyla doldur). Boşsa https://gazla.app varsayılır.
EXPO_PUBLIC_WEB_BASE_URL=
# Davet linki kökü; boşsa <WEB_BASE_URL>/d (link: <kök>/<kod>)
EXPO_PUBLIC_INVITE_BASE_URL=
# Destek e-postası (Ayarlar > Bize yaz)
EXPO_PUBLIC_SUPPORT_EMAIL=
